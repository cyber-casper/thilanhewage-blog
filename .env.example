# Read-only "thilanhewage.com" Notion integration secret — separate from
# HexOrbit's own integrations (see docs/ADR-001-notion-access-and-architecture.md).
# Notion → my-integrations → thilanhewage.com → Internal Integration Secret.
NOTION_API_KEY=

# 🔎 Research Digests database + data source (already created — shared, not
# duplicated, per ADR-001). Must be shared with the integration above from
# its Notion "Connections" menu before queries will succeed.
NOTION_DATABASE_ID=3614ed92-d44b-49fd-ab8f-6440064a1f8e
NOTION_DATA_SOURCE_ID=cfbdc68e-09fb-43b5-8c2b-437db02bbd25

# Used to build absolute links in /rss.xml. Defaults to the production
# domain if unset, so this only needs setting for local dev if you want RSS
# links to point at localhost instead.
# SITE_URL=http://localhost:3000
SITE_URL=https://thilanhewage.com

PORT=3000
